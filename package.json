{
  "name": "patterned",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @patterned/web",
    "build:web": "npm run build --workspace @patterned/web",
    "typecheck:web": "npm run typecheck --workspace @patterned/web",
    "typecheck:api": "npm run typecheck --workspace @patterned/api",
    "typecheck:worker": "npm run typecheck --workspace @patterned/worker"
  }
}
