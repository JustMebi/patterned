{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@patterned/measurement-engine": ["packages/measurement-engine/src"],
      "@patterned/garment-schema": ["packages/garment-schema/src"],
      "@patterned/fabric-catalogue": ["packages/fabric-catalogue/src"],
      "@patterned/entitlements": ["packages/entitlements/src"],
      "@patterned/pattern-engine": ["packages/pattern-engine/src"],
      "@patterned/shared-utils": ["packages/shared-utils/src"]
    }
  }
}
